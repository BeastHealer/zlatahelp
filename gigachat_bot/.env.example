# Telegram Bot Token
# Получите токен у @BotFather в Telegram
# 1. Найдите @BotFather в Telegram
# 2. Отправьте команду /newbot
# 3. Следуйте инструкциям и скопируйте токен

BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# GigaChat API Client ID
# Получите CLIENT_ID на https://developers.sber.ru/gigachat
# CLIENT_ID используется как RqUID (Request Unique ID) в запросах к API

CLIENT_ID=your_client_id_here

# GigaChat API Client Secret
# Получите CLIENT_SECRET на https://developers.sber.ru/gigachat
# CLIENT_SECRET - отдельная переменная (если требуется)

CLIENT_SECRET=your_client_secret_here

# GigaChat API Authorization Key
# Получите AUTHORIZATION_KEY на https://developers.sber.ru/gigachat
# AUTHORIZATION_KEY используется для Authorization key в запросах
# Это может быть готовый ключ в формате: Basic <encoded_credentials>
# Или просто encoded_credentials (без "Basic "), бот добавит префикс автоматически

AUTHORIZATION_KEY=your_authorization_key_here
