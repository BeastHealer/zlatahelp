# Каталог состояния: база, загрузки, календарь ICS, зеркало Notion
DATA_DIR=./data

HOST=0.0.0.0
PORT=8090
PUBLIC_BASE_URL=http://127.0.0.1:8090

# Учебная организация. На показе это стенд, не данные заказчика.
ORG_NAME=АНО «Злата»
OWNER_ID=owner
# Дата, от которой считаются «четверг» и «завтра». Пусто — сегодняшняя дата машины.
ASSISTANT_TODAY=

# Один руководитель. Чужой чат отклоняется.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# demo — встроенный планировщик, работает без ключа.
# openai — любой OpenAI-совместимый шлюз.
# gigachat — OAuth GigaChat, в LLM_API_KEY кладётся Authorization key.
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# mirror — страницы видны на /notion без сети.
# api — после «да» страница ещё и создаётся в Notion.
NOTION_MODE=mirror
NOTION_TOKEN=
NOTION_DATABASE_ID=

# catalog — учебные источники. web — ещё и живой адрес из сообщения плюс краткий поиск.
SEARCH_ENGINE=catalog

# --- Вторая версия (python -m nko2, порт 8091) ---
# Yonote вместо Notion. Хосты app.yonote.ru, api.vk.com и почта по IMAP доступны из России.
PORT_V2=8091
PUBLIC_BASE_URL_V2=http://127.0.0.1:8091
LEADER_NAME=Злата
YONOTE_MODE=mirror
YONOTE_TOKEN=
YONOTE_BASE_URL=https://app.yonote.ru/api
YONOTE_COLLECTION_ID=
TELEGRAM_CHANNEL_ID=
VK_TOKEN=
VK_GROUP_ID=
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
KEYWORDS=цифровизация, партнёрство, гранты НКО
